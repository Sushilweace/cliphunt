# --- Server ---
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_GB=4

# --- Transcription: openai | local | mock | none ---
# openai = Whisper API (word timestamps). local = faster-whisper via python. mock = fake words for testing.
TRANSCRIBE_PROVIDER=local
OPENAI_API_KEY=
LOCAL_WHISPER_MODEL=small

# --- AI highlight detection, titles, descriptions ---
# auto = Gemini if GEMINI_API_KEY is set, else Anthropic, else local Ollama.
# gemini is the fast hosted option (Flash). ollama is local. none = transcript heuristic only.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_HOST=http://127.0.0.1:11434
# Best local fit for a 4 GB GPU: llama3.2:3b. A 7B model is slower here because it cannot stay fully on the GPU.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200
OLLAMA_TIMEOUT_MS=180000

# Analysis token caps. 0 means no cap.
# Project cap covers highlight windows plus post copy. Clip cap covers one post-copy call.
MAX_PROJECT_TOKENS=80000
MAX_CLIP_TOKENS=8000

# Reject sources longer than this before transcription. Raise it if you have the time and disk.
MAX_DURATION_MIN=120

# Set to 1 to render the highest-scoring clip as soon as analysis finishes.
AUTO_RENDER=0

# --- Text-to-speech voice-over (optional, uses OPENAI_API_KEY) ---
TTS_MODEL=tts-1

# --- YouTube links (needs yt-dlp installed). Read README "Legal" first. ---
ENABLE_YOUTUBE=1

# --- Extra font folder for captions (optional) ---
FONTS_DIR=
